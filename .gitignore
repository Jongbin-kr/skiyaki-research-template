# AI/ML Research Template - Git Exclusions
#
# This file excludes secrets, large artifacts, and generated files from version control
# while preserving directory structure through .gitkeep files.

# ============================================================================
# Python Cache and Build Artifacts
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Virtual environments
venv/
ENV/
env/
.venv

# ============================================================================
# Secrets and Credentials
# ============================================================================

# Environment files
.env
.env.local
.env.*.local

# Token files
*.token
*.key
*.pem

# SSH keys
id_rsa
id_ed25519

# API keys and credentials
credentials.json
secrets.yaml
secrets.yml

# ============================================================================
# Outputs Directory (exclude contents, preserve structure)
# ============================================================================

# Exclude all contents of outputs/
outputs/*

# But keep the .gitkeep file to preserve directory structure
!outputs/.gitkeep

# ============================================================================
# Experiment Run Logs
# ============================================================================

# Raw Slurm/run logs in experiments (kept local only, never committed)
experiments/*/logs/*.out
experiments/*/logs/*.err
experiments/*/logs/*.log

# ============================================================================
# Weights & Biases Cache
# ============================================================================

# W&B directories in experiments
experiments/*/wandb/

# W&B directories at root (if accidentally created)
wandb/

# ============================================================================
# Model Checkpoints and Large Artifacts
# ============================================================================

# PyTorch checkpoints
*.pt
*.pth
*.ckpt

# TensorFlow checkpoints
*.h5
*.hdf5

# Model directories (often contain large files)
experiments/*/runs/*/checkpoints/
experiments/*/runs/*/models/

# ============================================================================
# Hypothesis Property-Test Cache
# ============================================================================

.hypothesis/

# ============================================================================
# Jupyter Notebook Checkpoints
# ============================================================================

.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ============================================================================
# Editor and IDE Files
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================================
# Operating System Files
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================================
# Data Files (optional - uncomment if needed)
# ============================================================================

# Uncomment to exclude data directory contents while preserving structure
# data/*
# !data/.gitkeep
# !data/README.md

# ============================================================================
# Kiro Workspace / Template-Maintainer Notes (not for distribution)
# ============================================================================

# The entire .kiro/ folder is local-only. It holds the template's own build
# specs, the development-history backup bundle, and instance-specific config
# snapshots (real SSH host, IP, remote paths) that must not ship in the
# distributed template.
.kiro/

# ============================================================================
# Preserve Directory Structure
# ============================================================================

# Never ignore .gitkeep files - they preserve empty directories
!.gitkeep
!**/.gitkeep
